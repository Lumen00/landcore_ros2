<launch>
  <arg name="rviz_config_file" default="$(find-pkg-share land_description)/rviz/config_real.rviz" />

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config_file)"/>

    <!-- Activate SLAM Node -->
    <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py"/>
    <!-- Activate NAV2 Node -->
    <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py"/>

</launch>
