<?xml version="1.0"?>
<robot name="land" xmlns:xacro="https://ros.org/wiki/xacro">

    <!-- CONSTANTS -->
    <xacro:property name="base_width" value="0.221"/>
    <xacro:property name="base_length" value="0.262"/>
    <xacro:property name="base_height" value="0.061"/>

    <xacro:property name="wheel_radius" value="0.04"/>
    <xacro:property name="wheel_width" value="0.04"/>

    <xacro:property name="wheel_ygap" value="0.005"/> <!-- Gap between wheel and chassis -->
    <xacro:property name="wheel_zoff" value="0.01"/> <!-- position along z axis -->
    <xacro:property name="wheel_xoff" value="0.111"/> <!-- position along x axis -->

    <xacro:property name="tower_width" value="0.086"/>
    <xacro:property name="tower_height" value="0.066"/>
    <xacro:property name="tower_length" value="0.06"/>


  <!-- Define inertial property macros  -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

    <!-- ROBOT BASE -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
    </link>

    <!-- ROBOT FOOTPRINT-->
    <link name="base_footprint">
        <xacro:box_inertia m="2" w="${base_width}" d="${base_length}" h="${base_height}"/>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0.0 0.0 ${-(wheel_radius+wheel_zoff)}" rpy="0 0 0"/>
    </joint>

    <!-- MAIN TOWER -->
    <link name="tower_link">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${tower_length} ${tower_width} ${tower_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.5" w="${tower_width}" d="${tower_length}" h="${tower_height}"/>
        <visual>
            <geometry>
                <box size="${tower_length} ${tower_width} ${tower_height}"/>
            </geometry>
            <material name="Cyan">
                <color rgba="0 1.0 1.0 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="tower_joint" type="fixed">
        <parent link="base_link"/>
        <child link="tower_link"/>
        <origin xyz="0.0 0.0 ${base_height/2 + tower_height/2}" rpy="0 0 0"/>
    </joint>

    <!-- WHEELS -->
    <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
        <link name="${prefix}_link">
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="Gray">
                    <color rgba="0.5 0.5 0.5 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_link"/>
            <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${-wheel_zoff}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel prefix="back_left" x_reflect="-1" y_reflect="1"/>
    <xacro:wheel prefix="back_right" x_reflect="-1" y_reflect="-1"/>    
    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>    
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>    

    <!-- IMU -->
    <link name="imu_link">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.01 0.001"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.01" w="0.02" d="0.01" h="0.001"/>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.02 0.01 0.001"/>
            </geometry>
            <material name="Cyan">
                <color rgba="0.0 1.0 1.0 1.0"/>
            </material>
        </visual>        
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="${0.01+tower_length/2} 0 ${base_height/2}" rpy="0 0 0"/>
    </joint>

    <!-- LIDAR -->

    <link name='lidar_link'>
      <visual name="lidar_link_visual">
        <geometry>
            <cylinder radius="${0.051/2}" length="0.018"/>
        </geometry>
      </visual>

      <collision name="lidar_link_collision">
        <geometry>
            <cylinder radius="${0.051/2}" length="0.018"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="0.125" r="${0.051/2}" h="0.018"/>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="0 0 ${base_height/2 + tower_height/2 + 0.018/2}" rpy="0 0 0"/>
    </joint>

    <!-- CAMERA -->

    <link name='camera_link'>
      <visual name="camera_link_visual">
        <geometry>
            <box size="0.001 0.025 0.025"/>
        </geometry>
      </visual>

      <collision name="camera_link_collision">
        <geometry>
            <box size="0.001 0.025 0.025"/>
        </geometry>
      </collision>

      <xacro:box_inertia m="0.01" w="0.025" h="0.025" d="0.001"/>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${tower_length/2} 0 ${base_height/2 + (3*tower_height/4)}" rpy="0 0 0"/>
    </joint>

    <!-- ROS2 WHEEL CONTROL -->

    <ros2_control name="MecanumHardware" type="system">
        <hardware>
            <plugin>land_description/MecanumSystemHardware</plugin>
        </hardware>

        <xacro:macro name="wheel_ros2_control" params="name">
            <joint name="${name}_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
        </xacro:macro>

        <xacro:wheel_ros2_control name="front_left"/>
        <xacro:wheel_ros2_control name="front_right"/>
        <xacro:wheel_ros2_control name="back_left"/>
        <xacro:wheel_ros2_control name="back_right"/>
    </ros2_control>
</robot>
