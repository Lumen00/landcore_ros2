      </geometry>
    </collision>
  </link>

  <link name="back_left_wheel">
    <inertial>
      <origin xyz="-0.000000 -0.000000 0.020565" rpy="0 0 0"/>
      <mass value="1.492323"/>
      <inertia ixx="7.236928e-04" ixy="2.045480e-11" ixz="-1.892112e-09"
               iyy="7.236931e-04" iyz="0.000000e+00" izz="1.090287e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.040400" rpy="2.635497 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://land_v2_description/meshes/Mecanum_Wheel_Assembly/back_left_wheel.dae" scale="1 1 1"/>
      </geometry>
      <!-- <material name="Steel"/> -->
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.040400" rpy="2.635497 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://land_v2_description/meshes/Mecanum_Wheel_Assembly/back_left_wheel_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel">
    <inertial>
      <origin xyz="-0.000000 -0.000000 0.020565" rpy="0 0 0"/>
      <mass value="1.492323"/>
      <inertia ixx="7.236928e-04" ixy="2.045479e-11" ixz="-1.892111e-09"
               iyy="7.236931e-04" iyz="0.000000e+00" izz="1.090287e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.000000 0.000000 0.040400" rpy="2.635497 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://land_v2_description/meshes/Mecanum_Wheel_Assembly/front_left_wheel.dae" scale="1 1 1"/>
      </geometry>
      <!-- <material name="Steel"/> -->
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.040400" rpy="2.635497 1.570796 0.000000"/>
      <geometry>
        <mesh filename="package://land_v2_description/meshes/Mecanum_Wheel_Assembly/front_left_wheel_collision.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.041800 0.002765 0.094100" rpy="-0.000000 0.000000 0.000000"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.083100 0.002515 0.022540" rpy="-0.000000 0.000000 0.000000"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.081000 0.002465 0.064692" rpy="-0.000000 0.000000 0.000000"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.153244 -0.136291 -0.082475" rpy="1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_wheel"/>
    <origin xyz="-0.069244 -0.136291 -0.082475" rpy="1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_wheel"/>
    <origin xyz="-0.070244 0.141721 -0.082475" rpy="-1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.152244 0.141721 -0.082475" rpy="-1.570796 0.000000 0.000000"/>
    <axis xyz="0.000000 0.000000 1.000000"/>
    <limit effort="100.0" velocity="1.00"/>
  </joint>

  <!-- ROS 2 control: generated generic system -->
  <!-- replace with old controls for land v1. -->
  <ros2_control name="land_v2_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="cmd_topic">sim/land_v2_system/cmd</param>
      <param name="state_topic">sim/land_v2_system/state</param>
    </hardware>

    <joint name="back_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="back_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_left_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>